(* intentlang grammar.
   Notation: W3C EBNF. 'x' is a literal token; X? optional; X* zero or more;
   X+ one or more; (A | B) alternation. Lexical rules follow the syntax.
   Every ```spec block in SPEC.md must parse under this grammar; run
   `python3 tools/check_examples.py` to confirm. *)

(* ======================= Files and statements ======================= *)

File          ::= Gap ( Statement ( NL+ Statement )* )? Gap EOF

Statement     ::= Import
                | Use
                | Moved
                | ProjectDecl
                | StackDecl
                | ModuleDecl
                | 'export'? Exportable

Exportable    ::= LetDecl
                | TypeDef
                | KindDef
                | AnnotationDef
                | TemplateDef
                | NamedDecl
                | Expansion

Import        ::= 'import' ImportSource ( 'as' Ident )?
ImportSource  ::= Path
                | 'module' Path
                | 'package' LineString
Use           ::= 'use' LineString 'for' Ident Record?
Moved         ::= 'moved' Address '->' Address
Address       ::= Word ( '.' Word )* ( '#' Word )?
                  (* a canonical address, never resolved through bindings;
                     '#' names an expect item, see "Identity" in SPEC.md *)

ProjectDecl   ::= 'project' Ident Block
StackDecl     ::= 'stack' Block
ModuleDecl    ::= 'module' Block
LetDecl       ::= 'let' Ident '=' Gap Expr
TypeDef       ::= 'type' Ident '=' Gap Expr
KindDef       ::= 'kind' Ident Block
AnnotationDef ::= 'annotation' Ident Block
NamedDecl     ::= 'extern'? Path Ident Annotation* Block

TemplateDef   ::= 'template' Ident '(' Gap Params? Gap ')' TemplateBody
Params        ::= Param ( ',' Gap Param )* ','?
Param         ::= Ident ':' Gap Expr
TemplateBody  ::= '{' Gap ( TemplateStmt ( NL+ TemplateStmt )* )? Gap '}'
TemplateStmt  ::= 'export'? ( NamedDecl | LetDecl )
Expansion     ::= 'expand' Path Ident '(' Gap Args? Gap ')'
Args          ::= Arg ( Sep Arg )* Sep?
Arg           ::= Word ':' Gap Expr

(* ======================= Bodies ======================= *)

Block         ::= '{' Gap ( Member ( Sep Member )* Sep? )? Gap '}'
Member        ::= Word MemberRest
MemberRest    ::= ':' Gap Expr Default? Annotation*      (* a field   *)
                | Block                                  (* a section *)
Default       ::= '=' Gap Expr
Annotation    ::= '@' Path ( '(' Gap ( Expr ( Sep Expr )* Sep? )? Gap ')' )?

(* ======================= Expressions =======================
   One expression grammar for values and type expressions; the field's
   schema decides which reading applies (SPEC.md "Values and types").
   Selectors are a separate form introduced by 'select'. *)

Expr          ::= Selector
                | Union
Union         ::= Postfix ( '|' Gap Postfix )*
Postfix       ::= Prefix '?'?
Prefix        ::= 'ref' Primary
                | Primary
Primary       ::= String
                | Number
                | 'true' | 'false' | 'null'
                | 'self'
                | Path Record?          (* reference, or constructor record *)
                | List
                | Record
                | '(' Gap Expr Gap ')'
List          ::= '[' Gap ( Expr ( Sep Expr )* Sep? )? Gap ']'
Record        ::= '{' Gap ( RecordField ( Sep RecordField )* Sep? )? Gap '}'
RecordField   ::= Word ':' Gap Expr Default? Annotation*

Selector      ::= 'select' SelectSource ( 'where' Gap Predicate )?
SelectSource  ::= '*'
                | Path
                | '[' Gap Path ( Sep Path )* Sep? Gap ']'
Predicate     ::= Conjunction ( 'or' Gap Conjunction )*
Conjunction   ::= Negation ( 'and' Gap Negation )*
Negation      ::= 'not' Gap Negation
                | '(' Gap Predicate Gap ')'
                | Test
Test          ::= 'exists' Access
                | Access CompareOp Gap Operand
Access        ::= 'meta' '.' Word                (* module, name or kind *)
                | Word ( '.' Word )*             (* a field of the candidate *)
CompareOp     ::= '==' | '!=' | '<' | '<=' | '>' | '>='
                | 'matches' | 'in' | 'contains'
Operand       ::= String | Number | 'true' | 'false' | 'null' | Path | List

Path          ::= Ident ( '.' Word )*
Sep           ::= ',' Gap
                | NL+
Gap           ::= NL*

(* ======================= Lexical rules ======================= *)

(* Line breaks. NL is LF; CRLF is normalised to LF first. NL tokens are
   preserved, never inferred or deleted: a production accepts a line break
   only where it says Gap, NL+ or Sep. In practice an expression may break
   after an opener, a comma, ':', '=', '|', 'where', 'and', 'or', 'not' or a
   comparison operator, and nowhere else. So

       plan: "free" |
         "team"            // valid
       plan: "free"
         | "team"          // error: the field ended at the line break

   Whitespace is spaces and tabs. A comment runs from '//' to just before
   the next NL, so it never swallows a statement boundary. Comments are not
   recognised inside strings. *)

Word          ::= [A-Za-z_] [A-Za-z0-9_]*
Ident         ::= Word - Keyword
Keyword       ::= 'import' | 'export' | 'extern' | 'use' | 'for' | 'as'
                | 'moved' | 'let' | 'type' | 'kind' | 'annotation'
                | 'template' | 'expand' | 'project' | 'stack' | 'module'
                | 'package' | 'ref' | 'self' | 'select' | 'where' | 'and'
                | 'or' | 'not' | 'exists' | 'meta' | 'matches' | 'in'
                | 'contains' | 'true' | 'false' | 'null'

(* Keywords are reserved only where Ident is required: statement heads,
   declaration names, the first segment of a Path. A Word, keyword or not,
   is accepted as a field or section name, a record key, a path segment
   after '.', and an annotation name after '@.'. Kind definitions may not
   declare fields named meta, not, exists, and, or, in, matches, contains,
   true, false or null, so every field is reachable in a selector. *)

Number        ::= '-'? [0-9]+ ( '.' [0-9]+ )?

String        ::= LineString | ProseString
LineString    ::= '"' LinePart* '"'
ProseString   ::= '"""' ProsePart* '"""'
LinePart      ::= Text | Escape | Mention | Interp | LiteralOpener
ProsePart     ::= Text | ProseEscape | Mention | Interp | LiteralOpener
Mention       ::= '@{' ( Path | 'self' ) '}'
Interp        ::= '${' Word '}'
LiteralOpener ::= '@@{' | '$${'          (* produce '@{' and '${' *)
Escape        ::= '\' ( '"' | '\' | 'n' | 't' | 'u{' Hex+ '}' )
ProseEscape   ::= '\"""'                 (* produces '"""' *)

(* String scanning is a state machine, not character-class subtraction.
   Inside a literal, at each position try in order:
     1. the closing delimiter ('"' or '"""');
     2. a literal opener '@@{' or '$${' (emitted as text, never rescanned);
     3. a mention '@{' Path '}' or an interpolation '${' Word '}';
     4. an escape (line strings: backslash escapes; prose: only '\"""');
     5. otherwise one character of text.
   An opening '"""' is preferred over '"'. A lone '@', an email address,
   '|', '//' and Markdown backticks are ordinary text. '@{' not followed by
   a well-formed Path and '}' is an error; write '@@{' for a literal one.
   Mentions are recognised inside Markdown code fences too. Line strings may
   not contain a raw line break. \u{...} must be a Unicode scalar value.

   Interpolation '${name}' is legal only in fields whose schema type is
   'template' (output paths in kind definitions); it names a field of the
   kind being defined and resolves nothing else. Elsewhere it is an error.

   Prose dedent. A ProseString whose opening '"""' is directly followed by
   NL is a block literal:
     - drop that first NL;
     - the closing '"""' must stand on its own line, after indentation only,
       and that line is excluded from the computation;
     - remove the smallest leading-space count found on non-blank lines from
       every non-blank line; blank lines become empty;
     - keep the final content line's NL;
     - a tab in block indentation is an error.
   A ProseString on one line ("""like this""") gets no dedent. *)
