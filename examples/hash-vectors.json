{
  "description": "Canonical JSON test vectors for tools/canon.py and any other implementation. Values are given as JSON; implementations must produce exactly `canonical` and `sha256`. Numbers in `value` are read as the JSON text writes them.",
  "vectors": [
    {
      "name": "key order and whitespace do not matter",
      "value": {
        "b": 1,
        "a": [
          true,
          null,
          "x"
        ]
      },
      "canonical": "{\"a\":[true,null,\"x\"],\"b\":1}",
