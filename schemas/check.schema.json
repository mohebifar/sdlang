{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdlang.dev/schemas/check.schema.json",
  "title": "Check protocol",
  "description": "How the CLI runs a conformance or test check and what it returns. The check's argv runs without a shell, reads one input document on stdin and writes one result document on stdout, then exits 0. Any other exit, or a result that fails this schema, is an infrastructure error. Build checks do not use this protocol: they pass on exit 0.",
  "$defs": {
    "check_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition_hash"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Qualified check name, e.g. nextjs.test."
        },
        "definition_hash": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check",
        "graph",
        "outputs",
        "package_root",
        "profile",
        "protocol",
        "purpose",
        "scope",
        "scratch",
        "snapshot",
        "subject",
        "workdir"
      ],
      "properties": {
        "protocol": {
          "const": "sdlang.check/1"
        },
        "check": {
          "$ref": "#/$defs/check_ref"
        },
        "purpose": {
          "enum": [
            "conformance",
            "test"
          ]
        },
        "scope": {
          "enum": [
            "declaration",
            "project"
          ]
        },
        "subject": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/address"
            },
            {
              "type": "null"
            }
          ],
          "description": "The declaration checked; null for a project-scope check."
        },
        "outputs": {
          "type": "array",
          "description": "The subject's owned outputs (for a test check, the one test output being run). Empty for project scope.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "member",
              "path"
            ],
            "properties": {
              "member": {
                "$ref": "common.schema.json#/$defs/member"
              },
              "path": {
                "type": "string"
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_]*$"
          },
          "description": "Conformance only: the declared rules that apply to the subject's kind. The result must report each exactly once for the subject, and nothing else."
        },
        "snapshot": {
          "$ref": "common.schema.json#/$defs/digest",
          "description": "The frozen candidate being checked."
        },
        "workdir": {
          "type": "string",
          "description": "Absolute path of a disposable copy of the candidate tree; the check's working directory. Writes there are discarded and never published."
        },
        "scratch": {
          "type": "string",
          "description": "Absolute path of a disposable writable directory, also used for caches."
        },
        "package_root": {
          "type": "string",
          "description": "Absolute path of the installed package, against which package-relative argv entries resolve."
        },
        "profile": {
          "type": "string",
          "description": "Name and version of the execution profile."
        },
        "graph": {
          "type": "string",
          "description": "Absolute path of the canonical graph the transaction is checked against (schemas/graph.schema.json): the applied graph, meaning published declarations plus this transaction's. Read-only."
        },
        "expected_cases": {
          "type": "array",
          "description": "Test only: the cases and instance keys that current evidence relies on. Each must appear in the result; a missing one counts as not passed.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case",
              "keys"
            ],
            "properties": {
              "case": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$"
              },
              "keys": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "inputs": {
          "$ref": "common.schema.json#/$defs/digest",
          "description": "Test only: digest of the run input closure, computed by the CLI. The result echoes it."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "conformance"
              }
            }
          },
          "then": {
            "required": [
              "rules"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "expected_cases"
                  ]
                },
                {
                  "required": [
                    "inputs"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "purpose": {
                "const": "test"
              }
            }
          },
          "then": {
            "required": [
              "expected_cases",
              "inputs"
            ],
            "not": {
              "required": [
                "rules"
              ]
            },
            "properties": {
              "scope": {
                "const": "declaration"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "declaration"
              }
            }
          },
          "then": {
            "properties": {
              "subject": {
                "type": "string"
              },
              "outputs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "subject": {
                "type": "null"
              },
              "outputs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "conformance_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "check",
        "snapshot",
        "results"
      ],
      "properties": {
        "protocol": {
          "const": "sdlang.check/1"
        },
        "check": {
          "$ref": "#/$defs/check_ref"
        },
        "snapshot": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule",
              "subject",
              "status",
              "inputs"
            ],
            "properties": {
              "rule": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$"
              },
              "subject": {
                "$ref": "common.schema.json#/$defs/address"
              },
              "status": {
                "enum": [
                  "satisfied",
                  "violated",
                  "unsupported",
                  "error"
                ]
              },
              "message": {
                "type": "string",
                "maxLength": 2000
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Repository paths the rule read."
              }
            }
          }
        }
      }
    },
    "test_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "check",
        "snapshot",
        "output",
        "selection",
        "cases",
        "inventory",
        "inputs",
        "profile"
      ],
      "properties": {
        "protocol": {
          "const": "sdlang.check/1"
        },
        "check": {
          "$ref": "#/$defs/check_ref"
        },
        "snapshot": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "output": {
          "$ref": "common.schema.json#/$defs/member"
        },
        "selection": {
          "enum": [
            "complete",
            "filtered"
          ],
          "description": "filtered: some discovered cases were not run; they count as not passed."
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "case",
              "oracle",
              "instances"
            ],
            "properties": {
              "case": {
                "type": "string",
                "pattern": "^[a-z_][a-z0-9_]*$"
              },
              "oracle": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "instances": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "key",
                    "attempts"
                  ],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "attempts": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "enum": [
                          "passed",
                          "failed",
                          "skipped",
                          "error"
                        ]
                      }
                    },
                    "generated": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "generator",
                        "input",
                        "seed"
                      ],
                      "description": "For generated or random cases: what produced this instance. It covers only this execution.",
                      "properties": {
                        "generator": {
                          "type": "string"
                        },
                        "input": {
                          "$ref": "common.schema.json#/$defs/digest"
                        },
                        "seed": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "untagged": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "failed"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "description": "Tests without a stable tag: they can fail the check but never provide coverage."
        },
        "inventory": {
          "$ref": "common.schema.json#/$defs/digest",
          "description": "Digest of the canonical JSON of the sorted [case, key] pairs of every tagged instance discovered, run or not. With selection complete it must equal the digest of the reported pairs."
        },
        "inputs": {
          "$ref": "common.schema.json#/$defs/digest",
          "description": "Echo of the input's inputs: the run input closure digest computed by the CLI."
        },
        "profile": {
          "type": "string"
        }
      }
    }
  }
}
