{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentlang.dev/schemas/review-order.schema.json",
  "title": "Review order",
  "description": "A review dispatch against a frozen candidate. The reviewer wrote none of the candidate's code and has no write authority. One order may batch many subjects; each needs its own verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "dispatch",
    "binding",
    "subjects",
    "context",
    "verdict_path",
    "tools"
  ],
  "properties": {
    "schema": {
      "const": "intentlang.review-order/1"
    },
    "dispatch": {
      "$ref": "common.schema.json#/$defs/dispatch"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_hash",
        "plan_hash",
        "candidate_snapshot",
        "graph_hash",
        "lock_hash"
      ],
      "properties": {
        "order_hash": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "plan_hash": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "candidate_snapshot": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "graph_hash": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "lock_hash": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "subject",
          "text",
          "contract_hash",
          "context_hash",
          "policy",
          "assess"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "subject": {
            "description": "A named requirement, or a compiler-issued context subject (requirement '<target>#context.<source-hash-prefix>') for normative prompt text without an expect member.",
            "$ref": "common.schema.json#/$defs/subject"
          },
          "text": {
            "type": "string"
          },
          "previous_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "contract_hash": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "context_hash": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "policy": {
            "$ref": "common.schema.json#/$defs/policy"
          },
          "assess": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "conformance",
                "coverage",
                "regression"
              ]
            }
          },
          "code": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Candidate paths relevant to this subject."
          },
          "coverage_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "tests",
                "run_receipts"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "tests": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "test",
                      "oracle"
                    ],
                    "properties": {
                      "test": {
                        "$ref": "common.schema.json#/$defs/test"
                      },
                      "oracle": {
                        "$ref": "common.schema.json#/$defs/digest",
                        "description": "Oracle digest: the case plus its helpers, fixtures, setup, runner configuration and snapshots."
                      }
                    }
                  }
                },
                "run_receipts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "regression": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "observed",
                  "pre_fix_receipt",
                  "candidate_receipt"
                ],
                "properties": {
                  "kind": {
                    "const": "automated"
                  },
                  "observed": {
                    "type": "string"
                  },
                  "pre_fix_receipt": {
                    "type": "string"
                  },
                  "candidate_receipt": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "observed",
                  "reason",
                  "artifacts"
                ],
                "properties": {
                  "kind": {
                    "const": "not_automatable"
                  },
                  "observed": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  },
                  "artifacts": {
                    "type": "array",
                    "items": {
                      "$ref": "common.schema.json#/$defs/resource"
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "assess": {
                  "contains": {
                    "const": "coverage"
                  }
                }
              }
            },
            "then": {
              "required": [
                "coverage_candidates"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "assess": {
                  "contains": {
                    "const": "regression"
                  }
                }
              }
            },
            "then": {
              "required": [
                "regression"
              ]
            }
          }
        ]
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inherited",
        "references",
        "manifest"
      ],
      "properties": {
        "manifest": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/resource"
          },
          "description": "Candidate-bound resources (code, tests, artifacts) served by read_context."
        },
        "inherited": {
          "description": "Project, then ancestor modules outermost first, then matching rules by address.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "normative",
              "hash",
              "text"
            ],
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^(project|module:[A-Za-z0-9_.]+|rule:[A-Za-z0-9_.]+)$"
              },
              "normative": {
                "type": "boolean",
                "description": "true for prompt and rule expectations, false for hint."
              },
              "hash": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "text": {
                "type": "string"
              },
              "previous_text": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Present when this input changed and caused work."
              }
            }
          }
        },
        "references": {
          "description": "Consumed and observed projections of everything the subjects reference, changed or not. Always inline: part of the mandatory context, never truncated or fetched.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "target",
              "relation",
              "projection",
              "viewpoint",
              "hash",
              "text"
            ],
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/address"
              },
              "target": {
                "type": "string",
                "description": "An address, or a canonical catalog symbol such as npm:ui-sdk::Link."
              },
              "relation": {
                "type": "string"
              },
              "projection": {
                "enum": [
                  "public",
                  "behaviour",
                  "catalog"
                ]
              },
              "viewpoint": {
                "enum": [
                  "applied",
                  "desired"
                ],
                "description": "Ordering relations read the applied graph; mentions may read a pending declaration's desired projection."
              },
              "hash": {
                "$ref": "common.schema.json#/$defs/digest"
              },
              "text": {
                "type": "string"
              },
              "previous_text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "verdict_path": {
      "type": "string",
      "pattern": "^\\.spec/run/[a-z0-9/_-]+/verdict\\.json$"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mcp"
      ],
      "properties": {
        "mcp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "transport",
            "command",
            "protocol"
          ],
          "properties": {
            "transport": {
              "const": "stdio"
            },
            "command": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "protocol": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
