import package "./spec-packages/rust" as rust
import graph
import canon
import plan

module {
  summary: "Phase 5: applying a plan transaction by transaction"
  prompt: """
    docs/spec.md's Apply, Plan binding and Verification sections and docs/protocol.md are the
    contract; every protocol document written or read validates against its schema in
    schemas/. Transactions run serially in the plan's order. Each runs in a candidate git
    worktree; nothing reaches the user's branch unless every obligation and policy of the
    transaction is met on the frozen candidate, and then code, state and evidence land in
    one commit carrying the transaction in a Spec-Transaction trailer.
    Agents, reviewers, generators and checks are external commands. The CLI never trusts
    their claims: it derives the diff, protects the spec and adopted files, attributes every
    change to its owner, runs checks from
    the package's definitions and computes evidence itself.
    Agents and checks run in their own process groups with a time limit; the whole group
    is stopped when they exit or time out.
  """
}

export rust.crate apply {
  summary: "The sdlang-apply crate"
  uses: [workspace, process, orders, checks, evidence, imports, names, mcp, engine]
  expect {
    end_to_end: "a plan for a small project with a local package applies with a scripted agent, reviewer, generator and checks: one commit per transaction, state and evidence published, journal written"
    protected: "an agent that writes to the spec fails its attempt with protected_changed, and nothing publishes when attempts run out"
    failed_check: "a failing test check fails the attempt; the next attempt carries the failure inline"
    dependents_skipped: "when a transaction fails, transactions after it that depend on it are skipped and the rest still run"
    binding: "apply refuses to start when any input differs from the plan's binding"
    resume: "rerunning apply after a published transaction skips it by the journal and continues"
  }
}

export lib workspace {
  summary: "Git operations: HEAD, candidate worktrees, frozen snapshots, the frozen diff and fast-forwarding the branch"
  exports: ["Repo", "Candidate", "Change"]
  expect {
    candidate: "a candidate is a detached worktree under .spec/run, which git ignores through info/exclude"
    freeze: "freezing commits the candidate's whole tree and names the snapshot by its commit"
    diff: "the frozen diff lists every added, modified and deleted path against the transaction's base"
    publish: "publishing fast-forwards the user's branch to the transaction commit and refuses if the branch moved"
  }
}

export lib process {
  summary: "Running external commands in their own process group, with stdin, captured output and a time limit"
  exports: ["run", "Finished"]
  expect {
    timeout: "a command still running at its limit is stopped with its whole process group and reported as timed out"
    tree: "processes a command left running are stopped when it exits"
    contained: "stopping a group that has already exited signals no other process, on Linux as on macOS"
  }
}

export lib imports {
  summary: "Import and export scanning for TypeScript and JavaScript, used to propose edges for adopted code"
  exports: ["specifiers", "exports", "resolve_local"]
  expect {
    scan: "import, export-from, dynamic import and require specifiers are found; comments and other strings are ignored"
  }
}

export lib names {
  summary: "Lenient names in a result: a full member or any unambiguous tail of it"
  exports: ["resolve", "key"]
  expect {
    short: "filter, expect.filter and tasks.list_tasks#expect.filter name the same requirement"
    ambiguous: "a name that matches no member, or more than one, is an error listing the candidates"
  }
}

export lib mcp {
  summary: "The MCP tool server for one dispatch, over stdio JSON-RPC (docs/protocol.md, MCP tools)"
  exports: ["serve"]
  expect {
    tools: "it lists get_task, get_declaration, read_context, get_diagnostic, run_self_check and validate_result, each with its input schema"
    declarations: "get_declaration serves any declaration of the bound graph, and answers not_found for an unknown address"
    resources: "read_context serves a manifest resource in pages whose bytes match its digest"
    self_check: "run_self_check runs a self_check check on the current tree and marks its receipt advisory"
    validate: "validate_result reports names that resolve to nothing and protected files changed as problems, and files outside the subjects as notes"
    no_writes: "no tool writes state or records evidence"
  }
}

export lib orders {
  summary: "Work orders, review orders and generator inputs, with their binding and Markdown rendering"
  exports: ["work_order", "review_order", "generator_input", "render"]
  expect {
    order_hash: "order_hash is the digest of the order's canonical JSON without it"
    spec_text: "a subject's current spec is its source text; the previous one comes from the plan's baseline commit, or null for a new declaration"
    files: "each subject lists its owned outputs with their expected bytes, or absent for a slot not yet written, and its creation roots ending in a slash, as where to start rather than a limit"
    requirements: "every expect and errors member is a requirement with its effective policy: the union of the member's, matching rules' and the project's verify, judged by default"
    context: "inherited normative context comes project first, then modules outermost first, then rules; every consumed or observed projection of a referenced declaration is inline"
  }
}

export lib checks {
  summary: "The check protocol: resolving check definitions from packages and running build, test and conformance checks"
  exports: ["CheckDef", "resolve_checks", "run_check"]
  expect {
    build: "a build check passes on exit 0 and keeps a bounded excerpt otherwise"
    test: "a test check receives one input document per test output and returns per-case attempts; a missing, skipped or failed-then-passed case does not pass"
    conformance: "a conformance check reports each applicable rule; a missing rule counts as error"
    run_inputs: "a run's input digest is computed from files on disk by one function shared with sdc check; a project-scope closure is every file git sees except .spec/ and the plan document"
    definition_hash: "a check's definition hash is the digest of its canonical definition, so editing it in the candidate changes nothing"
    isolation: "anything a check writes in the candidate is discarded before publishing"
  }
}

export lib evidence {
  summary: "Evidence records and policy satisfaction from runs and verdicts"
  exports: ["Evidence", "requirement_evidence", "summary_label"]
  expect {
    tests_policy: "a tests policy needs every bound case passed and a sufficient coverage verdict"
    review_policy: "a review-only policy needs a conforms verdict"
    approval: "an approval policy cannot be met by apply and blocks publishing"
    label: "the summary label is failed, stale, unverified, or the policy it meets, in that order"
  }
}

export lib engine {
  summary: "The transaction loop: binding, tasks, freeze, checks, reviews, retries, publish and journal"
  exports: ["apply", "ApplyOptions", "ApplyReport"]
  uses: [workspace, process, orders, checks, evidence, names]
  expect {
    binding: "the baseline commit, graph, lock, state digest and every fingerprint must equal the plan's binding"
    serial: "transactions run in plan order; a transaction whose after list names a failed or skipped one is skipped"
    generator: "a generator task runs the generator protocol, and its output may write only listed slots and retained roots"
    agent: "a transaction's coding subjects go to one agent in one order, written to .spec/run/<dispatch>/ and rendered on its stdin; a result at result_path is optional"
    scope: "a changed file owned by a declaration outside the transaction makes it touched: it is checked, reviewed and recorded with the transaction; unmanaged files may change; the spec, its lock, packages and state, adopted files and frozen declarations' files may not"
    created: "a new file under a creation root that no result claims becomes a created output keyed by its stem"
    retries: "a failed attempt is retried up to attempt.max with every earlier failure inline; a generator failure is never retried by an agent"
    publish: "on success, state records for the transaction's declarations are written against the new graph, the applied store is extended, and one commit is made"
    journal: "each published transaction appends a receipt with its input and result commits to .spec/journal/<plan>.jsonl"
    mcp_config: "each coding dispatch gets an MCP client configuration naming sdc mcp for it, in SPEC_MCP_CONFIG"
    escalation: "an obligated declaration a review finds nonconforming, or whose policy is not met, becomes an update on the next attempt, with the finding inline; a frozen one, or one with no attempt or agent left, fails the transaction"
    coverage_retry: "a requirement of a subject being coded whose tests the reviewer finds insufficient fails the attempt, and the next attempt gets the reviewer's reason inline"
    test_bindings: "a requirement is bound to the cases tagged with its key in its declaration's test outputs unless a result binds it; a result binding whose names resolve to nothing is ignored and the next attempt is told"
    moves: "outputs whose path changed (a moved declaration, a moved creation root) are moved in the candidate before any agent runs, and the order names where each came from"
    acquire: "an acquire entry runs no agent and no review: build checks run, its claimed files' current bytes become its baseline, its requirements publish unverified with the import's test bindings, and it leaves .spec/import.json"
    infrastructure: "a check that fails for infrastructure reasons is rerun once before the transaction fails, and never costs a coding attempt"
  }
}
