export lib lexer {
  summary: "Tokens for .int source, produced with logos"
  exports: ["Token", "TokenKind", "lex"]
  uses: [strings]
  expect {
    newlines_kept: "line breaks are tokens; spaces, tabs and comments are not"
    crlf: "CRLF is normalised to LF before lexing, and spans refer to the normalised text"
    punctuation: "'->', '==', '!=', '<=' and '>=' each lex as one token"
    numbers: "'-1.5' is one number token, and '->' is never part of a number"
    strings: "a string literal lexes as one token carrying its scanned parts"
  }
}

export lib strings {
  summary: "String literals: parts, escapes, mentions, interpolations and prose dedent"
  exports: ["StringLit", "StringKind", "Part", "scan_line", "scan_prose"]
  expect {
    order: "inside a literal, the closing delimiter, literal openers, mentions and interpolations, escapes and plain text are tried in that order"
    openers: "a doubled at-sign or dollar sign before an opening brace produces a literal opener as text"
    bad_mention: "a mention opener not followed by a well-formed path or self and a closing brace is an error"
    escapes: "line strings accept backslash escapes for quote, backslash, n, t and u with hex digits; prose accepts only an escaped triple quote"
    scalar: "a u escape outside the Unicode scalar values is an error"
    raw_newline: "a raw line break inside a line string is an error"
    dedent: "a block literal drops its first line break, removes the smallest indentation of its non-blank lines and keeps its final line break"
    inline_prose: "a triple-quoted string on one line is not dedented"
    tabs: "a tab in block indentation is an error"
    closing_line: "a block literal's closing delimiter must stand on its own line"
  }
}

export lib ast {
  summary: "The syntax tree, with a byte span on every node, serialisable to JSON"
  exports: ["File", "Statement", "Exportable", "Block", "Member", "Expr", "Selector", "Predicate", "Span"]
  expect {
    spans: "every node carries the byte range of the source it came from"
    json: "the tree serialises to JSON with stable, snake_case field names"
  }
}

export lib parser {
  summary: "Recursive-descent parser from tokens to the syntax tree"
  exports: ["parse", "ParseError"]
  uses: [lexer, strings, ast]
  expect {
    statement_lines: "statements are separated by line breaks; two statements on one line are an error"
    line_breaks: "an expression may break only after an opener, a comma, ':', '=', '|', 'where', 'and', 'or', 'not' or a comparison operator"
    keywords: "keywords are rejected only where an identifier is required"
    first_error: "parsing stops at the first error and reports its span, what was expected and what was found"
  }
}

export lib diagnostics {
  summary: "Renders parse errors as text with a source excerpt"
  exports: ["render"]
  uses: [parser]
  expect {
    excerpt: "a rendered error names the file, line and column and underlines the offending span"
  }
}
