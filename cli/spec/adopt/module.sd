import package "./spec-packages/rust" as rust
import graph
import plan
import apply

module {
  summary: "Phase 6b: brownfield adoption with sdc import"
  prompt: """
    docs/spec.md's Brownfield adoption section is the contract. An import proposes; only
    --accept writes, and then only new .sd files for proposed libs and the pending
    acquisitions in .spec/import.json, which the next sdc plan reads. No package code
    runs: exports, imports and test tags are read from the files. It
    claims nothing it was not pointed at and never creates competing claims: a path two
    declarations could own is a collision, and a proposal with a collision cannot be
    accepted. The proposal's text is meant for a human reviewer, so it says what will be
    claimed, by whom, and what is left for later.
  """
}

export rust.crate adopt {
  summary: "The sdlang-adopt crate"
  uses: [scan, proposal, accept]
  expect {
    worked: "on a project whose spec declares a page that imports an unowned src/lib/auth.ts exporting signIn and requestReset, importing that file proposes lib auth.auth_lib with path src/lib/auth.ts, lists both exports and the importing page, and says the page needs uses: [auth_lib]"
    existing: "importing files laid out by a declaration's templates maps each to its slot, and a file under its creation root to a created output keyed by the file's stem"
  }
}

export lib scan {
  summary: "The project's source files, their exports and imports, and who imports each file"
  exports: ["scan", "Scanned"]
  uses: [apply.imports]
  expect {
    walk: "paths are files or directories relative to the project; .git, .spec, node_modules, spec and spec-packages are skipped"
    exports: "named exports from export function, const, let, class, type, interface and export { a, b as c } are found, and export default as default"
    importers: "a relative or @/ import is resolved to a project file by trying the TypeScript extensions and index files"
  }
}

export lib proposal {
  summary: "The ownership mapping proposed for the pointed-at files"
  exports: ["propose", "Proposal", "Claim"]
  uses: [scan]
  expect {
    slot: "a file at a slot of a managed declaration with no state record is claimed for that slot"
    created: "a file under a creation root of a managed declaration with no state record is claimed as a created output keyed by its stem"
    owned: "a file a state record already owns is reported as owned and not claimed"
    collision: "a file two declarations could claim is a collision and claimed by neither"
    kind_inputs: "a file a kind names as an input, such as a root layout, is left unmanaged unless a slot claims it"
    new_lib: "an unclaimed TypeScript or JavaScript file is proposed as a new lib; its name comes from the lib template when the path fits it, and otherwise it keeps the file with path"
    integration: "a proposed lib whose file has two or more exports imported from two or more declarations is labelled one integration owner, with extern and planned extraction offered as the other choices"
    grants: "a declaration whose files import a proposed lib's file is listed as needing uses on it"
    unresolved: "a relative import of a project file that nothing owns or claims is an unresolved dependency"
    unclaimed: "a slot of a claimed declaration whose file exists but was not pointed at is reported, and claimed by nothing"
    tests: "a requirement is bound to a claimed test output's case when the file has a [case:<tag>] tag equal to the requirement's key; a tested requirement with none is reported"
  }
}

export lib accept {
  summary: "Accepting a proposal: the new lib files and the pending acquisitions"
  exports: ["accept"]
  uses: [proposal, plan.planner]
  expect {
    refuses: "a proposal with a collision is not accepted and nothing is written"
    writes: "each proposed lib is written to spec/<module>/<name>.sd; an existing file there is an error"
    pending: "every claimed declaration and proposed lib is written to .spec/import.json with its claimed slots, created outputs and test bindings, after checking that they plan"
    rollback: "when the spec no longer compiles or plans with the new files, they are removed and nothing is written"
  }
}
