import package "./spec-packages/rust" as rust

module {
  summary: "Phase 2: canonical JSON, digests and declaration projections"
  prompt: """
    Byte-for-byte agreement with tools/canon.py is the contract: the vectors in
    examples/hash-vectors.json and the projection hashes in examples/hashes.json must
    reproduce exactly. No I/O: functions take JSON values and return values.
  """
}

export rust.crate canon {
  summary: "The intlang-canon crate"
  uses: [canonical_json, projections]
  expect {
    vectors: "every vector in examples/hash-vectors.json reproduces its canonical text and digest"
    worked_hashes: "the projections of examples/graph.before.json and examples/graph.after.json equal examples/hashes.json"
  }
}

export lib canonical_json {
  summary: "Canonical JSON text and sha256 digests, as SPEC.md's Projections and hashes defines them"
  exports: ["canonical", "digest", "CanonError"]
  expect {
    sorted_keys: "object keys are NFC-normalised and sorted by Unicode code point"
    duplicate_keys: "two keys that are equal after NFC normalisation are an error"
    nfc_strings: "every string is NFC-normalised"
    escapes: "strings escape only the quote, the backslash and control characters, using short escapes where JSON has them and lowercase u00XX otherwise"
    integers: "an integer, or a float with an integral value, is written in plain decimal digits with no exponent, exactly"
    other_numbers: "any other number is written as JavaScript's Number.prototype.toString writes it"
    non_finite: "a number that does not fit a finite double is an error"
    digest: "a digest is 'sha256:' followed by the lowercase hex sha256 of the canonical text's UTF-8 bytes"
  }
}

export lib projections {
  summary: "The public, behaviour, body, guidance and context hashes of every declaration in a graph"
  exports: ["projections", "public_hashes", "Projections"]
  uses: [canonical_json]
  prompt: """
    Port tools/canon.py's projections and public_hashes. Until phase 3 reads interface
    fields from kind definitions, the interface table is the same fixed table as the
    reference's KIND_INTERFACE.
  """
  expect {
    set_fields: "set-valued fields (uses, calls, reads, writes, requires, skills) are sorted by the canonical JSON of their elements"
    type_refs: "a named type reference inside a public projection carries the referenced declaration's public hash"
    recursive_types: "mutually recursive declarations are hashed together as one strongly connected component, each member's hash being the component hash plus its address"
    inherited_context: "the context hash lists the project prompt, then ancestor module prompts outermost first, then matching rules"
  }
}
