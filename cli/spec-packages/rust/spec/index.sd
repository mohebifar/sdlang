// Local package `rust`: how the sdlang CLI's Cargo workspace is laid out.
// An sdlang module is one crate under crates/<module>; a `lib` is one Rust module
// file in that crate, with its unit tests in the same file.

// Shared code: one Rust module per lib.
export implements lib {
  outputs {
    main: "crates/${meta.module}/src/${meta.name}.rs"
  }
  checks: [build, clippy, test]
}

// A library crate: its manifest, its root (which declares and re-exports the libs it
// uses) and one integration test file.
export kind crate {
  outputs {
    manifest: "crates/${meta.module}/Cargo.toml"
    root: "crates/${meta.module}/src/lib.rs"
    tests: "crates/${meta.module}/tests/${meta.name}.rs"
  }
  checks: [build, clippy, test]
}

// A binary crate: its manifest, main.rs (which dispatches to the commands it uses) and
// one integration test file.
export kind binary {
  outputs {
    manifest: "crates/${meta.module}/Cargo.toml"
    root: "crates/${meta.module}/src/main.rs"
    tests: "crates/${meta.module}/tests/${meta.name}.rs"
  }
  checks: [build, clippy, test]
}

// One clap subcommand of a binary.
export kind command {
  fields {
    name: string @interface
  }
  outputs {
    main: "crates/${meta.module}/src/commands/${meta.name}.rs"
    tests: "crates/${meta.module}/tests/${meta.name}.rs"
  }
  exports {
    run {
      output: "main"
      symbol: "run"
      mode: "value"
    }
    args {
      output: "main"
      symbol: "Args"
      mode: "type"
    }
  }
  checks: [build, clippy, test]
}

// Toolchain files owned by the stack declaration.
export implements stack {
  outputs {
    manifest: "Cargo.toml"
    lockfile: "Cargo.lock"
    toolchain: "rust-toolchain.toml"
  }
}

export check build {
  purpose: "build"
  scope: "project"
  run: ["cargo", "build", "--workspace", "--locked"]
}

export check clippy {
  purpose: "build"
  scope: "project"
  run: ["cargo", "clippy", "--workspace", "--all-targets", "--", "-D", "warnings"]
}

// Test check: needs a reporter that turns `cargo test` output into the check protocol's
// test result. Until it exists, `cargo test --workspace` passing is the bar.
export check test {
  purpose: "test"
  scope: "declaration"
  run: ["cargo", "test", "--workspace", "--locked"]
}
