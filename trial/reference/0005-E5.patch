diff --git a/src/server/tasks/set_task_done.ts b/src/server/tasks/set_task_done.ts
index 26fc9ca..f0e1904 100644
--- a/src/server/tasks/set_task_done.ts
+++ b/src/server/tasks/set_task_done.ts
@@ -1,9 +1,9 @@
 import { find, save } from "../../lib/tasks/store";
 
 export type Input = { id: string; done: boolean };
-export type Output = { id: string; done: boolean };
+export type Output = { id: string; done: boolean; done_at: string | null };
 
-type Task = { id: string; title: string; done: boolean; created_at: string };
+type Task = { id: string; title: string; done: boolean; created_at: string; done_at?: string | null };
 
 /** A declared error: rejects with an Error whose code is the error's key. */
 function notFound(): Error {
@@ -16,6 +16,8 @@ export default async function setTaskDone(input: Input): Promise<Output> {
   if (!task) {
     throw notFound();
   }
-  save({ ...task, done: input.done });
-  return { id: task.id, done: input.done };
+  // done_at is when the task was marked done; null while it is open.
+  const done_at = input.done ? (task.done && task.done_at ? task.done_at : new Date().toISOString()) : null;
+  save({ ...task, done: input.done, done_at });
+  return { id: task.id, done: input.done, done_at };
 }
