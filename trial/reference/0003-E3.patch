diff --git a/tests/server/tasks/set_task_done.test.ts b/tests/server/tasks/set_task_done.test.ts
new file mode 100644
index 0000000..6b04c54
--- /dev/null
+++ b/tests/server/tasks/set_task_done.test.ts
@@ -0,0 +1,23 @@
+import setTaskDone from "../../../src/server/tasks/set_task_done";
+import { find, insert } from "../../../src/lib/tasks/store";
+
+beforeEach(() => {
+  delete (globalThis as { __tasksStore?: unknown }).__tasksStore;
+});
+
+const done = (id: string) => find<{ id: string; created_at: string; done: boolean }>(id)?.done;
+
+it("[case:toggles] set_task_done with done false makes a done task open again", async () => {
+  insert({ id: "t1", title: "Buy milk", done: false, created_at: "2026-01-01T10:00:00.000Z" });
+  expect(await setTaskDone({ id: "t1", done: true })).toEqual({ id: "t1", done: true });
+  expect(done("t1")).toBe(true);
+  expect(await setTaskDone({ id: "t1", done: false })).toEqual({ id: "t1", done: false });
+  expect(done("t1")).toBe(false);
+});
+
+it("[case:not_found] set_task_done fails with not_found exactly when no task has that id", async () => {
+  await expect(setTaskDone({ id: "missing", done: true })).rejects.toMatchObject({
+    code: "not_found",
+    message: "No task has that id",
+  });
+});
