--- /dev/null
+++ b/src/app/tasks/_parts/done_toggle.tsx
@@ -0,0 +1,28 @@
+"use client";
+
+/** A checkbox that submits the task's new done state as soon as it changes. */
+export default function DoneToggle({
+  id,
+  title,
+  done,
+  toggle,
+}: {
+  id: string;
+  title: string;
+  done: boolean;
+  toggle: (formData: FormData) => Promise<void>;
+}) {
+  return (
+    <form action={toggle}>
+      <input type="hidden" name="id" value={id} />
+      <input type="hidden" name="done" value={done ? "false" : "true"} />
+      <input
+        key={String(done)}
+        type="checkbox"
+        aria-label={`Done: ${title}`}
+        defaultChecked={done}
+        onChange={(e) => e.currentTarget.form?.requestSubmit()}
+      />
+    </form>
+  );
+}
