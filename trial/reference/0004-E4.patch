Subject: [PATCH 04/10] E4

---
 src/server/tasks/create_task.ts        | 4 ++--
 tests/server/tasks/create_task.test.ts | 6 ++++++
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/src/server/tasks/create_task.ts b/src/server/tasks/create_task.ts
index ec794a0..f14872d 100644
--- a/src/server/tasks/create_task.ts
+++ b/src/server/tasks/create_task.ts
@@ -3,11 +3,11 @@ import { insert } from "../../lib/tasks/store";
 export type Input = { title: string };
 export type Output = { id: string; title: string; done: boolean; created_at: string };
 
-/** Adds a task. */
+/** Adds a task, storing its title trimmed with inner runs of spaces collapsed to one. */
 export default async function createTask(input: Input): Promise<Output> {
   return insert<Output>({
     id: crypto.randomUUID(),
-    title: input.title,
+    title: input.title.trim().replace(/ {2,}/g, " "),
     done: false,
     created_at: new Date().toISOString(),
   });
diff --git a/tests/server/tasks/create_task.test.ts b/tests/server/tasks/create_task.test.ts
index 4cc3c34..89aed93 100644
--- a/tests/server/tasks/create_task.test.ts
+++ b/tests/server/tasks/create_task.test.ts
@@ -13,3 +13,9 @@ it("[case:stored] a created task is stored with its title, not done", async () =
   expect(find(task.id)).toEqual(task);
   expect(all().map((t) => t.id)).toEqual([task.id]);
 });
+
+it("[case:normalised] the title is stored trimmed, with inner runs of spaces collapsed", async () => {
+  const task = await createTask({ title: "  Buy   milk " });
+  expect(task.title).toBe("Buy milk");
+  expect(find<typeof task>(task.id)?.title).toBe("Buy milk");
+});
