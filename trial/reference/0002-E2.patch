+/** Lists all tasks, open ones first, each group newest first; with a status, only those. */
+export default async function listTasks(input: Input = {}): Promise<Task[]> {
+  const tasks = all<Task>().filter(
+    (t) => input.status === undefined || (input.status === "done") === t.done,
+  );
   return [...tasks.filter((t) => !t.done), ...tasks.filter((t) => t.done)].map((t) => ({
     id: t.id,
     title: t.title,
diff --git a/tests/server/tasks/list_tasks.test.ts b/tests/server/tasks/list_tasks.test.ts
index dddf852..eda0201 100644
--- a/tests/server/tasks/list_tasks.test.ts
+++ b/tests/server/tasks/list_tasks.test.ts
@@ -20,3 +20,11 @@ it("[case:order] open tasks come before done ones; within each group, newest fir
   const ids = (await listTasks({})).map((t) => t.id);
   expect(ids).toEqual(["open-new", "open-old", "done-new", "done-old"]);
 });
+
+it("[case:filter] with a status, only tasks with that status are returned; without one, all", async () => {
+  insert(task("open-1", 1, false));
+  insert(task("done-1", 2, true));
+  expect((await listTasks({ status: "open" })).map((t) => t.id)).toEqual(["open-1"]);
+  expect((await listTasks({ status: "done" })).map((t) => t.id)).toEqual(["done-1"]);
+  expect((await listTasks({})).map((t) => t.id)).toEqual(["open-1", "done-1"]);
+});
