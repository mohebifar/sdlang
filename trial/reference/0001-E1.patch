+import deleteTask from "../../../src/server/tasks/delete_task";
+import { find, insert } from "../../../src/lib/tasks/store";
+
+beforeEach(() => {
+  delete (globalThis as { __tasksStore?: unknown }).__tasksStore;
+});
+
+it("[case:not_found] delete_task fails with not_found exactly when no task has that id", async () => {
+  await expect(deleteTask({ id: "missing" })).rejects.toMatchObject({ code: "not_found" });
