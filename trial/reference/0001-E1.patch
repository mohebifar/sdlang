diff --git a/src/server/tasks/delete_task.ts b/src/server/tasks/delete_task.ts
new file mode 100644
index 0000000..4c8f50d
--- /dev/null
+++ b/src/server/tasks/delete_task.ts
@@ -0,0 +1,11 @@
+import { find, remove } from "../../lib/tasks/store";
+
+export type Input = { id: string };
+
+/** Deletes a task. */
+export default async function deleteTask(input: Input): Promise<void> {
+  if (!find(input.id)) {
+    throw Object.assign(new Error("No task has that id"), { code: "not_found" });
+  }
+  remove(input.id);
+}
