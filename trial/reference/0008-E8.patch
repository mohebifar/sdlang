--- a/tests/app/about/page.test.ts
+++ b/tests/app/about/page.test.ts
@@ -26,8 +26,13 @@ function render(node: unknown): { text: string; nodes: Visited[] } {
   return { text: walk(node, []), nodes };
 }
 
-it("[case:explains] the page has the heading 'About' and links to the task list", () => {
+it("[case:explains] the page has the heading 'About this app' and links to the task list", () => {
   const { nodes } = render(AboutPage());
-  expect(nodes.filter((n) => n.tag === "h1").map((n) => n.text)).toEqual(["About"]);
+  expect(nodes.filter((n) => n.tag === "h1").map((n) => n.text)).toEqual(["About this app"]);
   expect(nodes.some((n) => n.tag === "a" && n.props.href === "/todo")).toBe(true);
 });
+
+it("[case:trial_note] the page says 'Built for the sdlang trial.'", () => {
+  const { nodes } = render(AboutPage());
+  expect(nodes.some((n) => n.tag === "p" && n.text === "Built for the sdlang trial.")).toBe(true);
+});
